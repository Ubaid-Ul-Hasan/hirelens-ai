# Copy to .env and fill in as needed.
# No secrets are required for the core MVP (no external API calls are made).

# Embedding model override (defaults to sentence-transformers/all-MiniLM-L6-v2)
HIRELENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# FastAPI service port (Step 19)
HIRELENS_API_PORT=8000

# MLflow tracking URI (Step 22)
MLFLOW_TRACKING_URI=./mlruns
